{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["create_channels", "archive_channels", "merge_channels", "assign_tasks"],
  "properties": {
    "create_channels": {
      "type": "array",
      "description": "New channels to create with initial task assignments",
      "items": {
        "type": "object",
        "required": ["name", "tasks"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Channel name (kebab-case). Use #proj- prefix for project channels.",
            "pattern": "^(#proj-)?[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "tasks": {
            "type": "array",
            "description": "Task IDs to initially assign to this channel",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "archive_channels": {
      "type": "array",
      "description": "Channels to archive (rename to .archived.jsonl). Only for completed project channels.",
      "items": {
        "type": "string"
      }
    },
    "merge_channels": {
      "type": "array",
      "description": "Channel merge operations (merge 'from' into 'into')",
      "items": {
        "type": "object",
        "required": ["from", "into"],
        "properties": {
          "from": {
            "type": "string",
            "description": "Source channel to merge (will be archived after merge)"
          },
          "into": {
            "type": "string",
            "description": "Target channel to merge into"
          }
        }
      }
    },
    "assign_tasks": {
      "type": "array",
      "description": "Task-to-channel assignments. Must include all pending tasks.",
      "items": {
        "type": "object",
        "required": ["task", "channel"],
        "properties": {
          "task": {
            "type": "string",
            "description": "Task ID (e.g., '1075')"
          },
          "channel": {
            "type": "string",
            "description": "Target channel name"
          }
        }
      }
    }
  }
}
