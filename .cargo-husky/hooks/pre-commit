#!/bin/sh
#
# Pre-commit hook managed by cargo-husky.
# Matches CI: cargo clippy --all-targets --all-features -- -D warnings
#

set -e

echo '+cargo clippy --all-targets --all-features -- -D warnings'
cargo clippy --all-targets --all-features -- -D warnings
echo '+cargo fmt --all -- --check'
cargo fmt --all -- --check

if [ -d web-app/node_modules ]; then
  echo '+cd web-app && npx biome check .'
  (cd web-app && npx biome check .)
fi
