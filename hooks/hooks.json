{
  "PostToolUse": [
    {
      "matcher": "TaskCreate",
      "hooks": [
        {
          "type": "command",
          "command": "midtown hook task",
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "TaskUpdate",
      "hooks": [
        {
          "type": "command",
          "command": "midtown hook task",
          "timeout": 10
        }
      ]
    }
  ],
  "Stop": [
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "command",
          "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/channel-sync.sh",
          "timeout": 30
        }
      ]
    }
  ]
}
