{
  "autoUpdates": false,
  "autoCompact": true,
  "hooks": {
    "PostToolUse": [{
      "matcher": "AskUserQuestion",
      "hooks": [{
        "type": "command",
        "command": "{bin} agent hook ask"
      }]
    }],
    "Notification": [{
      "matcher": "idle_prompt",
      "hooks": [{
        "type": "command",
        "command": "{bin} agent hook idle"
      }]
    }]
  }
}
