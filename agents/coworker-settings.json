{
  "editorMode": "normal",
  "hooks": {
    "PostToolUse": [{
      "matcher": "TaskUpdate",
      "hooks": [{
        "type": "command",
        "command": "{bin} hook task"
      }]
    }, {
      "matcher": "TaskCreate",
      "hooks": [{
        "type": "command",
        "command": "{bin} hook task"
      }]
    }, {
      "matcher": "AskUserQuestion",
      "hooks": [{
        "type": "command",
        "command": "{bin} hook ask"
      }]
    }],
    "Notification": [{
      "matcher": "idle_prompt",
      "hooks": [{
        "type": "command",
        "command": "{bin} hook idle"
      }]
    }]
  }
}
