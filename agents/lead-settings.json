{
  "editorMode": "normal",
  "hooks": {
    "Stop": [{
      "hooks": [{
        "type": "command",
        "command": "{bin} hook lead-stop"
      }]
    }],
    "PostToolUse": [{
      "matcher": "TaskUpdate",
      "hooks": [{
        "type": "command",
        "command": "{bin} hook task"
      }]
    }, {
      "matcher": "TaskCreate",
      "hooks": [{
        "type": "command",
        "command": "{bin} hook task"
      }]
    }, {
      "hooks": [{
        "type": "command",
        "command": "{bin} hook insight"
      }]
    }]
  }
}
